rules_version = '2';

// O navegador não lê nem grava nada diretamente: a lista de espera é gravada pelo servidor
// (src/app/api/lista-espera, Firebase Admin), que não passa por estas regras.
// Publicar no console do Firebase (Firestore > Regras) ou com `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
