# Endereço público do site (links absolutos, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://ctbvirtual.com.br

# Firebase Admin (lista de espera no Firestore). Só no servidor: nunca use o prefixo NEXT_PUBLIC_.
# Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada:
# copie project_id, client_email e private_key do JSON baixado (a chave entre aspas, com os \n).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
